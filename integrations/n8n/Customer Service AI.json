    {
      "parameters": {
        "jsCode": "// งานจาก Bookdose: instructions (กติกาของงาน), schema (รูปแบบคำตอบ JSON), input (ข้อมูลที่ส่งมา), mode\n// สร้าง system + prompt ให้ AI Agent (double brace หนี template ของ n8n ไม่ให้ประเมิน { } ใน schema)\nconst job = $('Bookdose ส่งงาน AI').first().json.body;\nconst system = (job.instructions +\n  '\\n\\nReply with one JSON object only: no other text, no code fences. It must match this JSON Schema:\\n' +\n  JSON.stringify(job.schema))\n  .replace(/\\{/g, '{{').replace(/\\}/g, '}}');\nreturn [{ json: { system, prompt: job.input, mode: job.mode } }];\n"
      },
      "id": "5f8076b0-ad3a-4426-8615-3937130f8cda",
      "name": "เตรียมคำขอ",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        416
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt }}",
        "options": {
          "systemMessage": "={{ $json.system }}"
        }
      },
      "id": "c537b66e-af01-4a86-86b1-eedc7cf23fa4",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1472,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "// คำตอบของ AI Agent -> { result, usage } ที่ Bookdose รอรับ\n// Bookdose ตรวจคำตอบซ้ำอีกชั้น: Chatbot ตอบลูกค้าได้เฉพาะเมื่ออ้างข้อความจากบทความจริง ไม่อย่างนั้นส่งต่อเจ้าหน้าที่\nconst reply = $input.first().json;\nconst mode = $('เตรียมคำขอ').first().json.mode;\nlet usage = { input_tokens: 0, output_tokens: 0 };\n// AI Agent คืนข้อความไว้ใน output (สตริง)\nlet text = typeof reply.output === 'string' ? reply.output : (reply.output != null ? JSON.stringify(reply.output) : '');\ntext = text.replace(/<think>[\\s\\S]*?<\\/think>/g, '').replace(/```(?:json)?/gi, '').trim();\nconst start = text.indexOf('{');\nconst end = text.lastIndexOf('}');\nif (start < 0 || end < start) throw new Error('โมเดลไม่ได้ตอบเป็น JSON');\nconst result = JSON.parse(text.slice(start, end + 1));\nif (['draft', 'bot', 'test'].includes(mode)) {\n  // โมเดลเล็กมักใส่ชนิดข้อมูลผิดเล็กน้อย: จัดให้ตรงรูปแบบก่อนส่งกลับ\n  result.answer = typeof result.answer === 'string' ? result.answer : '';\n  result.summary = typeof result.summary === 'string' ? result.summary : '';\n  result.needs_human = result.needs_human === true || result.needs_human === 'true';\n  result.citations = Array.isArray(result.citations) ? result.citations : [];\n  if (mode === 'test') result.citations = [];\n}\nreturn [{ json: { result, usage } }];\n"
      },
