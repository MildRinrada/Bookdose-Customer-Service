      "id": "8a490241-ade0-40df-8511-4e7fef2838da",
      "name": "ตั้งค่า: ผู้ช่วยตอบ (AI tool)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        544,
        288
