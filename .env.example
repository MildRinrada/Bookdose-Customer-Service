# Copy to .env and change what you need. Every value is optional.
# Variables already set in the environment (for example on Render) take precedence over this file.

# Folder for databases, attachments and secrets (default: data/ next to app.py)
# BOOKDOSE_DATA=./data

# Defaults for app.py --host / --port / --secure-cookies
# BOOKDOSE_HOST=127.0.0.1
# BOOKDOSE_PORT=8787
# Only behind an HTTPS reverse proxy
# BOOKDOSE_SECURE_COOKIES=false

# API server: fastapi (FastAPI on uvicorn, default) or legacy (the old http.server, for rollback)
# BOOKDOSE_SERVER=fastapi

# Secret asked for when creating the platform owner on first run (at least 32 characters on Render)
# BOOKDOSE_SETUP_TOKEN=
