# Copy to .env.local and adjust. All are optional for local use.

# Where the Python server (python app.py) listens. The browser never calls it directly: /api/* is forwarded.
BOOKDOSE_API_URL=http://127.0.0.1:8787

# Set the same value on the Python server when this app runs on another machine (or is public, e.g. on Render).
# Without it, the Python server only trusts forwarded requests that come from this machine.
BOOKDOSE_PROXY_SECRET=

# 1 only behind a load balancer or reverse proxy that sets X-Forwarded-For (Render does). The browser's address is
# then passed on, so sign-in limits count per visitor instead of for everyone together.
BOOKDOSE_TRUST_FORWARDED_FOR=
